; CRT XR — Godot 4.5.1
config_version=5

[application]
config/name="CRT XR"
config/version="0.1.0-beta.9"
config/icon="res://artwork/Icon.png"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/minimum_display_time=0

[display]
window/dpi/allow_hidpi=true
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=4
environment/defaults/default_clear_color=Color(0.018, 0.024, 0.04, 1)
