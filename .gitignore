# Logs, Python caches, local environments and credentials.
*.log
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
*.pem
*.key

# Local IDE and operating-system files.
.vs/
*.user
*.suo
.DS_Store
Thumbs.db
Desktop.ini

# Original user-supplied furniture set; exports contain only the prepared table.
/wood_drawer__tables_set.glb
/wood_drawer__tables_set.glb.import
/wood_drawer__tables_set_*.png*

# Original console downloads; only prepared console resources are exported.
/super_retro_game_console*.glb
