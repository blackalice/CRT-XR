@@ -18,6 +18,28 @@
 #include "stdclass.h"
 #ifdef LIBRETRO
 #include "vmu_xhair.h"
+#include <libretro.h>
+#include <mutex>
+
+namespace {
+std::mutex crt_vmu_mutex;
+u8 crt_vmu_pixels[8][48 * 32]{};
+bool crt_vmu_valid[8]{};
+}
+// Optional CRT XR extension: a separate monochrome LCD, never an overlay.
+extern "C" RETRO_API bool retro_crt_xr_vmu_lcd(unsigned index, u8* destination, size_t size)
+{
+	if (index >= 8 || !destination || size != 48 * 32) return false;
+	std::lock_guard<std::mutex> lock(crt_vmu_mutex);
+	if (!crt_vmu_valid[index]) return false;
+	memcpy(destination, crt_vmu_pixels[index], 48 * 32);
+	return true;
+}
+void crt_xr_clear_vmu_lcd()
+{
+	std::lock_guard<std::mutex> lock(crt_vmu_mutex);
+	memset(crt_vmu_valid, 0, sizeof(crt_vmu_valid));
+}
 #endif
 
