@@ -1582,6 +1582,13 @@ bool retro_load_game(const struct retro_game_info *game)
 
 void retro_unload_game(void)
 {
+	// CRT XR: unloaded mid-boot, the loader thread would carry on into a shut
+	// down kernel; let it finish first.
+	if (g_pendingBoot)
+	{
+		PSP_CancelBoot();
+		g_pendingBoot = false;
+	}
 	if (Libretro::useEmuThread)
 		Libretro::EmuThreadStop();
 
