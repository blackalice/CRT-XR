 }
 
+// CRT XR: a frontend unloading while the loader thread still boots waits for
+// that thread (it needs nothing from the frontend), without the main-thread
+// GPU setup PSP_InitUpdate would do, so PSP_Shutdown then runs on a settled state.
+void PSP_CancelBoot() {
+	if (g_loadingThread.joinable())
+		g_loadingThread.join();
+	if (g_bootState == BootState::Failed) {
+		// The loader thread already shut down after its failure.
+		g_bootState = BootState::Off;
+	}
+}
+
 BootState PollBootState() {
 	return g_bootState;
 }
