+  // Libretro defers EmuThread until the first retro_run. If the frontend unloads
+  // earlier, no thread/scope guard exists to release the pending boot or restore
+  // the per-game config and state. Cancel that boot explicitly.
+  if (g_boot_params)
+  {
+    g_boot_params.reset();
+    // The renderer registered CP/PE events before HW::Init. HW::Shutdown will
