 #define MAIN_CEILING  ((uptr)1 << (sizeof(uptr) * 8 - 1))
 
+#if defined(__linux__)
+/* CRT XR: both maps are mapped over this arena in the image's own .bss: inside
+ * the image, so always within reach of its globals and of each other, whatever
+ * else the host has mapped around the module (a Godot room with other cores
+ * crowds it). It is also the same address for every game while the core stays
+ * loaded, which state kept across games assumes. The near search remains for a
+ * host where the arena cannot be mapped. Untouched .bss costs address space only. */
+#define FALLBACK_ARENA_SIZE (HOSTMEM_MAIN_SIZE + HOSTMEM_CODE_SIZE + 2 * RESERVE_ALIGN)
+static u8 s_fallback_arena[FALLBACK_ARENA_SIZE] __attribute__((aligned(4096)));
+
+static bool place_maps_in_image(SysMainMemory* m)
+{
+	uptr main_base = ((uptr)s_fallback_arena + RESERVE_ALIGN - 1) & ~(RESERVE_ALIGN - 1);
+	uptr code_base = (main_base + m->main.size + RESERVE_ALIGN - 1) & ~(RESERVE_ALIGN - 1);
+	if (code_base + m->code.size > (uptr)s_fallback_arena + sizeof(s_fallback_arena))
+		return false;
+	if (!vmm_map_over(&m->main, main_base))
+		return false;
+	if (!vmm_map_over(&m->code, code_base))
+	{
+		vmm_unmap(&m->main);
+		return false;
+	}
+	log_cb(RETRO_LOG_INFO, "Placed the memory maps in the core's own image (main at %p, code at %p).\n",
+	       (void*)m->main.baseptr, (void*)m->code.baseptr);
+	return true;
+}
+#endif
