 		vmm_map(&m->code, 0);
diff --git a/pcsx2/VirtualMemory.c b/pcsx2/VirtualMemory.c
index 3fd01ceb6..52450b2dd 100644
--- a/pcsx2/VirtualMemory.c
+++ b/pcsx2/VirtualMemory.c
@@ -105,6 +105,27 @@ bool vmm_map(VirtualMemoryManager* m, uptr base)
 	return m->baseptr != NULL;
 }
 
+#if defined(__linux__)
+/* CRT XR: exactly at base, replacing whatever the core itself has mapped there
+ * (its own .bss arena, see Memory.c). Only ever given memory the core owns. */
+bool vmm_map_over(VirtualMemoryManager* m, uptr base)
+{
+	void* p;
+	if (m->baseptr || !m->pageuse)
+		return false;
+	if (m->file_handle)
+		p = mmap((void*)base, m->size, PROT_READ | PROT_WRITE,
+				MAP_SHARED | MAP_FIXED, (int)(intptr_t)m->file_handle, 0);
+	else
+		p = mmap((void*)base, m->size, PROT_READ | PROT_WRITE | PROT_EXEC,
+				MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0);
+	if (p == MAP_FAILED || (uptr)p != base)
+		return false;
+	m->baseptr = (u8*)p;
+	return true;
+}
+#endif
