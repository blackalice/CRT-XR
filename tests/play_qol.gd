extends SceneTree
const History = preload("res://scripts/content/play_history.gd")
var failures := 0
func check(ok: bool, label: String):
	print("PASS: " if ok else "FAIL: ",label)
	if not ok: failures+=1
func _initialize(): call_deferred("run")
func settle():
	for i in range(4): await process_frame
func run():
	var history := History.new()
	history.path="user://history-test.cfg"
	history.read("missing/old.sfc")
	history.played("missing/new.sfc"); history.played("missing/old.sfc")
	check(history.recent==["missing/old.sfc","missing/new.sfc"],"Recent order, deduplication and missing-card retention")
	history.toggle("missing/new.sfc")
	var copy := History.new(); copy.path=history.path; copy.read()
	check(copy.favourites==["missing/new.sfc"],"Favourites persist independently of recency")
	for i in range(25): history.played("game%d.nes" % i)
	check(history.recent.size()==20 and history.recent[0]=="game24.nes","Recent history is bounded")
	DirAccess.make_dir_absolute(ProjectSettings.globalize_path(history.path+".tmp"))
	var before := history.favourites.duplicate()
	check(not history.toggle("unwritable.sfc") and history.favourites==before,"Failed favourite save rolls back")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(history.path+".tmp"))
	var app=load("res://scenes/main.tscn").instantiate(); root.add_child(app); app.use_tracking(false)
	var rom := ProjectSettings.globalize_path("res://build/crt-xr-probe.sfc")
	check(app.load_game(rom),"Diagnostic cartridge loads")
	app.close_settings(); await settle(); app.toggle_settings()
	check(app.emulator.save_state(),"Manual state saved")
	var manual: String = FileAccess.get_sha256(app.emulator.state_path())
	var original: PackedByteArray = app.emulator.core.save_state()
	check(app.emulator.save_auto(),"Automatic state saved")
	check(FileAccess.get_sha256(app.emulator.state_path())==manual,"Automatic save leaves manual slot unchanged")
	app.emulator.core.run_frame(0)
	check(app.emulator.load_auto() and app.emulator.core.save_state()==original,"Continue restores exact committed state")
	var automatic: String=app.emulator.auto_path_for(rom)
	app.emulator.core.run_frame(0); app.emulator.auto_saved=false
	var switched: PackedByteArray=app.emulator.core.save_state()
	check(app.load_game(rom) and app.emulator.load_auto() and app.emulator.core.save_state()==switched,"Switching games saves the outgoing committed state")
	var old_format := {"format":1,"rom":app.emulator.rom_hash,"core":app.emulator.core_identity,"state":original}
	app.emulator.write_bytes_atomic(app.emulator.state_path(),var_to_bytes(old_format))
	check(app.emulator.load_state(),"Existing timestamp-free manual saves remain readable")
	app.emulator.save_state()
	var menu=app.menu
	menu.open_library(); menu.open_history("recent"); menu.select("game:"+rom)
	menu.activate()
	check(menu.mode=="launch" and menu.selected_id=="launch.continue","Existing auto save offers Continue first")
	menu.back()
	check(menu.mode=="recent" and menu.selected_id=="game:"+rom,"Back restores originating game selection")
	menu.select_file(rom); menu.launch_game(rom,true)
	check(not menu.visible and not app.emulator.paused,"Continue closes the menu and resumes gameplay")
	app.toggle_settings()
	app.emulator.write_bytes_atomic(automatic,PackedByteArray([1,2,3]))
	var corrupt_hash := FileAccess.get_sha256(automatic)
	app.emulator.auto_saved=true
	menu.select_file(rom); menu.launch_game(rom,true)
	check(menu.visible and menu.mode=="launch" and menu.error_label.visible and FileAccess.get_sha256(automatic)==corrupt_hash,"Unreadable automatic save stays intact with Start fresh recovery")
	menu.launch_game(rom,false)
	check(not menu.visible and not app.emulator.paused,"Start fresh recovers without using the automatic state")
	await settle(); app.toggle_settings()
	menu.open_history("recent"); menu.select("game:"+rom)
	menu.toggle_favourite()
	check(rom in app.play_history.favourites,"Selected game can be favourited")
	menu.mode="pause"; menu.render(); menu.state_action(false)
	check(menu.mode=="confirm" and menu.selected_id=="cancel","Manual load requires confirmation, default Cancel")
	var current: PackedByteArray=app.emulator.core.save_state()
	menu.back()
	check(app.emulator.core.save_state()==current and app.emulator.paused,"Cancelled load preserves progress and pause")
	menu.state_action(false); menu.confirmed()
	check(menu.notification.contains("Loaded • Slot 1"),"Successful load names the slot, counted from 1 like the slot page")
	app.emulator.auto_saved=false
	DirAccess.make_dir_absolute(ProjectSettings.globalize_path(app.emulator.auto_path_for(rom)+".tmp"))
	app.request_exit()
	check(menu.visible and menu.error_label.visible,"Failed exit autosave keeps application and error visible")
	DirAccess.remove_absolute(ProjectSettings.globalize_path(app.emulator.auto_path_for(rom)+".tmp"))
	app.free(); await settle()
	quit(1 if failures else 0)
