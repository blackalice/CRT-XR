extends SceneTree
var app
var failures := 0
func _initialize(): call_deferred("run")
func check(ok: bool, title: String):
	print("PASS: " if ok else "FAIL: ",title)
	if not ok: failures+=1
func settle():
	for i in range(6): await process_frame
func page(category: int, subsection := 0):
	app.menu.mode="settings"; app.menu.category=category; app.menu.subsection=subsection; app.menu.preview=false; app.menu.render()
func capture(title: String):
	if DisplayServer.get_name()=="headless": return
	await settle(); RenderingServer.force_draw(false)
	DirAccess.make_dir_recursive_absolute("res://build/menu-improvements")
	app.menu_view.get_texture().get_image().save_png("res://build/menu-improvements/"+title+".png")
func run():
	app=load("res://scenes/main.tscn").instantiate(); root.add_child(app); app.use_tracking(false)
	await settle()
	var m=app.menu
	check(m.items[0].id=="home.library" and m.selected_id=="home.library","Without a last game, home leads with library setup")
	check(not m.items.any(func(i):return i.get("layout","")=="music_link"),"Idle music uses one compact action")
	m.notification_time=0; m.status_detail="Tracking troubleshooting"; m.select("home.library")
	check(not m.help_label.text.contains("Tracking troubleshooting"),"Device troubleshooting cannot replace selected-action help")
	await capture("home")
	m.open_library(); m.rom_index.cancel(); m.rom_index.games={}; m.render()
	check(m.items.size()==1 and m.items[0].id=="library.setup","Empty library offers a single setup action")
	await capture("empty-library")
	page(7); await settle()
	check(m.sidebar.get_child(1)==m.sidebar_buttons[7],"Quick settings is first in the sidebar")
	m.switch_category(1); check(m.category==0,"Next category from Quick settings follows sidebar order")
	m.switch_category(-1); check(m.category==7,"Previous category from View returns to Quick settings")
	check(m.items.map(func(i):return i.id)==["quick.view.distance","quick.view.height_offset","quick.view.recenter","quick.preset","quick.game_volume","quick.music_volume"],"Quick settings exposes all six everyday controls")
	m.select("quick.view.distance",false); await settle()
	var distance=m.selected_row(); var track_width: float=distance.track.size.x
	m.select("quick.view.height_offset",false); await settle()
	check(is_equal_approx(distance.track.size.x,track_width),"Selection preserves slider width and reserved arrow space")
	check(distance.track.get_theme_stylebox("fill").bg_color!=m.selected_row().track.get_theme_stylebox("fill").bg_color,"Only the focused slider uses amber")
	check(m.help_label.text==m.selected_row().item.help,"Context help explains the effect without repeating the title")
	page(1,1); m.select("crt.scanlines",false)
	var scan=m.selected_row(); app.scanlines=.35; scan.refresh()
	check(scan.range_max_label.text=="100%" and scan.formatted_value()=="50%","CRT strengths read as a share of their allowed range")
	var before: String=m.picture_signature()
	m.apply_preset("clean"); await settle()
	check(m.applied_preset()=="clean" and m.preset_caption().contains("Clean"),"Applied preset is identified")
	page(1,0); check(m.items.any(func(i):return i.id=="preset.clean" and i.value.contains("✓")),"Applied preset has an active checkmark")
	var saved: ConfigFile=app.capture_settings()
	app.picture_preset_id=""; app.apply_settings(saved)
	check(m.applied_preset()=="clean","Preset identity survives settings restore")
	page(1,1); m.select("crt.scanlines",false); m.adjust(1)
	check(m.applied_preset().is_empty() and m.preset_caption()=="Custom" and m.selected_row().changed_from_default(),"Manual changes show Custom and changed-from-default feedback")
	m.undo_picture_preset(); await settle()
	check(m.picture_signature()==before,"Preset undo restores the entire previous picture")
	page(1,1); m.select("crt.scanlines",false); m.adjust(-1); await settle()
	var custom: String=m.picture_signature()
	m.apply_preset("rgb"); m.apply_preset("pal"); await settle()
	page(7); var quick_preset: Dictionary=m.items.filter(func(i):return i.id=="quick.preset")[0]
	quick_preset.setter.call(0); await settle()
	check(m.picture_signature()==custom and m.applied_preset().is_empty(),"Custom in Quick settings brings back the hand-tuned picture after other presets")
	m.save_my_preset(0); await settle()
	check(m.my_preset_saved(0) and m.applied_preset()=="mine.0","The current picture saves as My preset 1")
	m.apply_preset("clean"); m.apply_my_preset(0); await settle()
	check(m.picture_signature()==custom and m.preset_caption().contains("My preset 1"),"A saved preset restores its picture")
	m.rename_my_preset(0,"Night"); page(7)
	check(m.items.filter(func(i):return i.id=="quick.preset")[0].choices.has("Night"),"Saved presets appear by name in Quick settings")
	page(1,0); check(m.items.any(func(i):return i.id=="preset.mine.0" and i.value.contains("✓")),"Picture → Presets marks the active saved preset")
	page(2,0); check(m.items[0].id=="music.game_volume" and m.items[1].id=="audio.mode","Audio starts with game volume and sound mode")
	app.music.duck_game=false; page(2,1); m.select("music.duck_game",false)
	check(m.rows[1].disabled,"Ducking amount is disabled while ducking is off")
	m.activate(); await settle(); check(not m.rows[1].disabled,"Enabling ducking enables its amount")
	m.set_input_kind("controller"); m.open_slot(0); m.select("slot.rename"); m.activate(); await settle()
	m.rename_field.text=""; m.select("key.0"); m.activate(); m.select("key.space"); m.activate(); m.select("key.1"); m.activate()
	check(m.rename_field.text=="a b","Controller can enter setup names without a keyboard")
	m.select("key.erase"); m.activate(); check(m.rename_field.text=="a ","Controller delete edits the field")
	m.select("key.caps"); m.activate(); m.select("key.0"); m.activate()
	check(m.rename_field.text=="a A","Switching case preserves the draft and cursor")
	m.select("rename.save"); m.activate(); check(m.draft_names[0]=="a A","Controller entry commits the complete draft")
	m.edit_radio_url(); m.rename_field.text=""; m.insert_text("https://example.com/live.mp3"); m.select("radio.save"); m.activate()
	check(app.music.station_url=="https://example.com/live.mp3","Radio URLs use the same text entry and validation")
	m.enter_folder_path(); m.rename_field.text=""; m.insert_text(ProjectSettings.globalize_path("res://build")); m.select("folder_path.open"); m.activate()
	check(m.mode=="browser","Folder entry opens the requested location")
	m.mode="rename"; m.entry_initialized=false; m.render(); await capture("controller-keyboard")
	for key in ["menu_large_text","menu_high_contrast","menu_reduced_motion","menu_sounds"]: app.set(key,true)
	m.apply_accessibility(); await settle()
	var prefs: ConfigFile=app.capture_settings()
	for key in ["menu_large_text","menu_high_contrast","menu_reduced_motion","menu_sounds"]: app.set(key,false)
	app.apply_settings(prefs)
	check(app.menu_large_text and app.menu_high_contrast and app.menu_reduced_motion and app.menu_sounds,"All accessibility preferences survive settings restore")
	for category in range(m.CATEGORIES.size()):
		for subsection in range(m.catalog.pages(category).size()):
			page(category,subsection); await settle()
			check(m.get_rect().end.x<=960 and m.get_rect().end.y<=720,"Larger-text page fits canvas: %d/%d" % [category,subsection])
	page(7); await capture("quick-large-controller")
	check(m.hints.get_child_count()<=4,"Settings footer has at most four contextual groups")
	check(m.hints.get_children().any(func(group):return group.get_children().any(func(child):return child.get_script()==preload("res://scripts/ui/button_glyph.gd"))),"Controller footer renders button icons")
	page(6); m.select("system.version"); check(m.selected_row().value_label.text==ProjectSettings.get_setting("application/config/version"),"Full version is available in About & Help")
	m.select("system.help"); m.activate(); await settle(); check(m.mode=="help" and m.help_copy.contains("Tracking"),"Troubleshooting opens a scrollable help page")
	m.back(); check(m.mode=="settings" and m.category==6,"Help returns to its original settings page")
	check(app.load_game(ProjectSettings.globalize_path("res://build/crt-xr-probe.sfc")),"Probe game loads")
	await settle()
	for i in range(120): app.emulator.core.run_frame(0)
	app.emulator.update_texture(true)
	m.open_pause(); m.state_action(true); await settle()
	var details: Dictionary=app.emulator.state_details(app.emulator.state_path())
	var image := Image.new()
	check(details.get("thumbnail") is PackedByteArray and image.load_png_from_buffer(details.thumbnail)==OK and image.get_width()==256,"New save contains a decodable thumbnail")
	var hash: String=FileAccess.get_sha256(app.emulator.state_path())
	m.state_action(true); await settle()
	check(m.mode=="confirm" and m.selected_id=="cancel" and m.confirm_panel.thumbnail.visible,"Overwrite shows a thumbnail and defaults to Cancel")
	check(m.confirm_panel.detail_label.text.contains("UTC") and m.confirm_panel.detail_label.text.contains("crt-xr-probe"),"Overwrite preview identifies game and timestamp")
	await capture("save-preview")
	m.back(); check(FileAccess.get_sha256(app.emulator.state_path())==hash,"Cancelling overwrite preserves the save")
	m.state_action(false); check(m.confirm_panel.thumbnail.visible,"Load shows the existing save thumbnail")
	m.back(); app.emulator.auto_saved=false; app.emulator.save_auto(); m.select_file(app.emulator.rom_path); await settle()
	check(m.mode=="launch" and m.column.get_children().any(func(child):return child is PanelContainer and child.get("thumbnail")!=null),"Continue offers an automatic-save preview")
	app.free(); await settle()
	print("MENU IMPROVEMENTS COMPLETE: ",failures," failures"); quit(1 if failures else 0)
