extends SceneTree
var failures := 0
func _initialize(): call_deferred("run")
func check(ok: bool, message: String):
	print("PASS: " if ok else "FAIL: ",message)
	if not ok: failures+=1
func run():
	var app=load("res://scenes/main.tscn").instantiate(); root.add_child(app); app.use_tracking(false)
	var effect=app.power_on
	check(not effect.started and effect.progress==0 and not effect.is_processing(),"Waits behind the startup menu instead of wasting the effect")
	check(is_equal_approx(effect.cue.stream.get_length(),.64),"Bundled CC0 startup excerpt is 0.640 seconds")
	var rom := ProjectSettings.globalize_path("res://build/retrocrt-probe.sfc")
	check(app.load_game(rom),"Diagnostic game loads")
	app.close_settings()
	check(effect.started and effect.progress==0 and not app.emulator.paused,"First reveal starts the effect without delaying gameplay")
	check(effect.cue.bus==app.emulator.player.bus,"Startup cue uses the TV audio route")
	var before: PackedByteArray=app.emulator.core.save_state()
	app.emulator.core.run_frame(0)
	check(app.emulator.core.save_state()!=before,"Emulator can advance immediately during power-on")
	effect.set_process(false); effect._process(.35)
	check(is_equal_approx(effect.progress,.5) and app.world.screen_light.power_level>0 and app.world.screen_light.power_level<1,"Picture and existing screen lighting warm up together")
	effect._process(.35)
	check(effect.progress==1 and not effect.is_processing(),"Effect completes in 0.70 seconds and stops processing")
	app.toggle_settings(); app.close_settings()
	check(effect.progress==1,"Opening and closing settings does not replay startup")
	app.toggle_settings(); app.preview_power_on()
	check(not app.menu.visible and effect.progress==0,"Preview closes the menu and replays the effect")
	effect.enabled=false; effect.apply(); effect.begin(true)
	check(effect.progress==1 and not effect.is_processing() and not effect.cue.playing,"Off bypasses animation and sound")
	effect.enabled=true; effect.sound_level=0; effect.apply(); effect.begin(true)
	check(effect.progress==0 and not effect.cue.playing,"Zero sound volume retains a silent picture effect")
	effect.sound_level=.25; effect.apply()
	var config: ConfigFile=app.capture_settings()
	effect.sound_level=.6; effect.enabled=false; app.apply_settings(config)
	check(effect.enabled and effect.sound_level==.25,"Power-on preferences persist independently of per-game picture")
	app.toggle_settings(); app.menu.open_settings(); app.menu.category=2; app.menu.subsection=3; app.menu.render()
	app.menu.select("atmosphere.power_sound"); app.menu.reset_option()
	check(is_equal_approx(effect.sound_level,.6),"Y resets only startup sound volume")
	app.free()
	print("POWER ON CHECKS COMPLETE: ",failures," failures")
	quit(1 if failures else 0)
