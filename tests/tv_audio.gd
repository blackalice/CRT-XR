extends SceneTree
var failures := 0
func _initialize(): call_deferred("run")
func check(ok: bool, message: String):
	print("PASS: " if ok else "FAIL: ",message)
	if not ok: failures+=1
func run():
	var baseline := AudioServer.bus_count
	var app=load("res://scenes/main.tscn").instantiate(); root.add_child(app); app.use_tracking(false)
	var audio=app.emulator.tv_audio
	var index := AudioServer.get_bus_index(audio.bus_name)
	check(AudioServer.bus_count==baseline+1 and AudioServer.get_bus_effect_count(index)==4,"One audio bus and stream shared between both eyes")
	check(audio.room.dry==1.0 and audio.width.time_pullout_ms==0.0 and audio.room.predelay_msec==12.0,"Direct path retains full dry signal and adds no stereo delay")
	audio.mode=0; audio.apply()
	check(app.emulator.player.bus=="Master" and not AudioServer.is_bus_effect_enabled(index,0),"Original mode bypasses every effect")
	audio.mode=1; audio.apply()
	check(app.emulator.player.bus==audio.bus_name and not AudioServer.is_bus_effect_enabled(index,2) and not AudioServer.is_bus_effect_enabled(index,3),"TV speaker mode has no room or head panning")
	audio.mode=2; audio.apply()
	audio.update_pose(Quaternion(Vector3.UP,-PI/2),Vector3.ZERO,Vector3(0,0,-3),1.0)
	check(audio.panner.pan<-.3,"Looking right moves TV audio towards the left ear")
	audio.update_pose(Quaternion(Vector3.UP,PI/2),Vector3.ZERO,Vector3(0,0,-3),1.0)
	check(audio.panner.pan>.3,"Looking left moves TV audio towards the right ear")
	audio.update_pose(Quaternion.IDENTITY,Vector3.ZERO,Vector3(0,0,-3),1.0)
	check(absf(audio.panner.pan)<.001,"Recenter returns sound to the middle")
	audio.directional_strength=0; audio.apply()
	check(audio.panner.pan==0 and not AudioServer.is_bus_effect_enabled(index,2),"Zero direction strength disables panning")
	audio.room_amount=0; audio.apply()
	check(not AudioServer.is_bus_effect_enabled(index,3),"Zero room amount disables reverb work")
	audio.speaker_character=0; audio.apply()
	check(audio.width.pan_pullout==1.0 and audio.eq.get_band_gain_db(0)==0.0,"Zero speaker character retains stereo and neutral EQ")
	audio.mode=2; audio.room_amount=.12; audio.speaker_character=.55; audio.directional_strength=.8; audio.apply()
	var config: ConfigFile=app.capture_settings()
	audio.reset_defaults(); app.apply_settings(config)
	check(audio.room_amount==.12 and audio.speaker_character==.55 and audio.directional_strength==.8,"Global audio controls round-trip through preferences")
	app.menu.open_settings(); app.menu.category=2; app.menu.subsection=0; app.menu.render()
	check(app.menu.items.size()==8,"Audio page exposes audio and power-on controls")
	app.menu.select("audio.room_amount"); app.menu.reset_option()
	check(is_equal_approx(audio.room_amount,.18),"Y resets only the selected audio setting")
	app.set_stereo(true)
	if DisplayServer.get_name()!="headless": check(Input.mouse_mode==Input.MOUSE_MODE_HIDDEN,"Cursor stays hidden in SBS")
	app.toggle_settings()
	if DisplayServer.get_name()!="headless": check(Input.mouse_mode==Input.MOUSE_MODE_HIDDEN,"Opening or closing menus does not reveal the SBS cursor")
	app.set_stereo(false)
	check(Input.mouse_mode==Input.MOUSE_MODE_VISIBLE,"Returning to mono restores the cursor")
	app.free()
	for i in range(3): await process_frame
	check(AudioServer.bus_count==baseline,"Closing the app releases its audio bus")
	print("TV AUDIO CHECKS COMPLETE: ",failures," failures")
	quit.call_deferred(1 if failures else 0)
