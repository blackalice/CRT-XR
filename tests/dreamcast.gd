extends SceneTree
const Registry = preload("res://scripts/emulation/core_registry.gd")
const Folders = preload("res://scripts/content/console_folders.gd")
const Layouts = preload("res://scripts/emulation/controller_layouts.gd")
const Pad = preload("res://scripts/emulation/gamepad_input.gd")
const Options = preload("res://scripts/emulation/core_options.gd")
var failures := 0
func check(ok: bool, label: String) -> void:
 print("PASS: " if ok else "FAIL: ", label)
 if not ok: failures += 1
func write(path: String, content: String) -> void:
 var file := FileAccess.open(path, FileAccess.WRITE)
 file.store_string(content)
func _initialize() -> void: call_deferred("run")
func run() -> void:
 var base := "user://fixtures/dreamcast"
 DirAccess.make_dir_recursive_absolute(base)
 write(base + "/Disc 1.gdi", '2\n1 0 4 2352 "track 01.bin" 0\n2 45000 4 2352 track02.bin 0\n')
 write(base + "/Disc 2.chd", "fixture")
 write(base + "/Game.m3u", "# playlist\nDisc 1.gdi\nDisc 2.chd\n")
 check(Folders.system("Sega Dreamcast") == "dreamcast" and not Folders.unsupported("dreamcast"), "Dreamcast folder aliases are supported")
 for file in ["Disc 1.gdi", "Disc 2.chd", "Game.m3u", "Game.cdi"]:
  check(Registry.identify(base + "/" + file) == "dreamcast", "Dreamcast identification: " + file)
 check(Registry.identify("user://unknown/game.chd").is_empty(), "CHD outside a console folder stays ambiguous")
 check(Registry.identify(base + "/track02.bin").is_empty(), "GDI tracks are not standalone games")
 var members := Registry.playlist_members([base + "/Game.m3u"])
 check(members.has(base + "/Disc 1.gdi") and members.has(base + "/track 01.bin") and members.has(base + "/track02.bin"), "Playlist hides GDI descriptors and quoted/unquoted tracks")
 write(base + "/Bad.m3u", "Game.m3u\n")
 check(Registry.identify(base + "/Bad.m3u").is_empty(), "Nested playlists are rejected")
 var index = load("res://scripts/content/rom_index.gd").new()
 index.start(ProjectSettings.globalize_path(base))
 while index.scanning: index.step(10000)
 check(index.games.dreamcast.size() == 1 and index.games.dreamcast[0].path.ends_with("Game.m3u"), "Library scan groups the two Dreamcast discs under their playlist")
 var browser = load("res://scripts/ui/rom_library.gd").new()
 browser.show_folder(ProjectSettings.globalize_path(base))
 check(browser.entries.filter(func(entry): return not entry.folder).size() == 1, "Folder browser also groups Dreamcast playlist members")
 var layout := Layouts.standard("dreamcast", Registry.SYSTEMS.dreamcast)
 check(Layouts.valid(layout) and Layouts.names("dreamcast")[0][1] == "A", "Dreamcast uses existing controller layout UI")
 var pad = Pad.new()
 var motion := InputEventJoypadMotion.new()
 motion.device = 1; motion.axis = JOY_AXIS_TRIGGER_LEFT; motion.axis_value = 0.25
 pad.handle_event(motion)
 check(pad.read(layout).pressure[0] in [8191,8192] and pad.read(layout).mask == 0, "Light trigger press remains proportional below digital threshold")
 Layouts.assign(layout, "l2", Layouts.R2)
 check(pad.read(layout).pressure[0] == 0 and pad.read(layout).pressure[1] in [8191,8192], "Trigger pressure follows remapping")
 pad.set_menu_active(true)
 check(pad.read(layout).pressure == PackedInt32Array([0,0]), "Menu suppresses trigger pressure")
 check(not Registry.SYSTEMS.dreamcast.preview and Registry.SYSTEMS.dreamcast.options.reicast_internal_resolution == "640x480", "Deck defaults use native resolution without input preview")
 check(Options.definitions("dreamcast").size() == 3, "Dreamcast options use existing console/per-game settings")
 var bios := ProjectSettings.globalize_path("user://fixtures/bios")
 DirAccess.make_dir_recursive_absolute(bios + "/dc")
 write(bios + "/dc/DC_BOOT.BIN", "test BIOS")
 OS.set_environment("CRT_XR_BIOS", bios)
 var saves := ProjectSettings.globalize_path("user://fixtures/saves")
 Registry.stage_bios("dreamcast", saves)
 check(FileAccess.get_file_as_string(saves + "/dc/dc_boot.bin") == "test BIOS", "Optional BIOS stages from EmuDeck dc folder, case insensitive")
 write(saves + "/dc/vmu_save_A1.bin", "persistent VMU")
 Registry.stage_bios("dreamcast", saves)
 check(FileAccess.get_file_as_string(saves + "/dc/vmu_save_A1.bin") == "persistent VMU", "BIOS staging preserves VMU saves")
 OS.set_environment("CRT_XR_BIOS", "")
 print("Dreamcast integration: ", failures, " failures")
 quit(1 if failures else 0)
